{
  "name": "frawly-mcp-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "generate-icon": "node scripts/generate-icon.mjs",
    "dev": "pnpm run generate-icon && wrangler dev",
    "deploy:staging": "pnpm run generate-icon && wrangler deploy --env staging",
    "deploy:production": "pnpm run generate-icon && wrangler deploy --env production",
    "test": "pnpm run generate-icon && vitest run",
    "test:coverage": "pnpm run generate-icon && vitest run --coverage",
    "typecheck": "pnpm run generate-icon && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "sharp": "^0.33.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
